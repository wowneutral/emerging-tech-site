# =============================================================================
# Emerging Tech — Apache / LiteSpeed configuration
#
# WHY THIS FILE EXISTS. The repo carries a `_redirects` file, which is
# Cloudflare Pages / Netlify syntax that Apache and LiteSpeed ignore entirely.
# On Hostinger it is an inert text file. Everything that mattered is restated
# here in a form the server actually reads. `_redirects` is kept in case the
# site ever returns to Cloudflare Pages; the two must be kept in step.
#
# SAFETY NOTE, READ BEFORE EDITING. Every directive below sits inside an
# <IfModule> guard and uses only FileInfo-class directives, which is what
# shared hosts normally permit in .htaccess. That is deliberate: a directive a
# host does not allow does not fail quietly, it returns 500 on EVERY page of
# the site. If the site 500s immediately after upload, rename this file to
# .htaccess.off and the site returns at once — then add these blocks back one
# at a time to find the one the host rejects.
# =============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Extensionless URLs ----------------------------------------------------
  # THE MOST IMPORTANT RULE IN THIS FILE. The site links internally as
  # `careers`, `openings`, `contact` with no .html. GitHub Pages resolves that
  # automatically and Apache does not, so without this every single nav item
  # 404s. This is the rule to test first after deploying.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # --- Retired URLs ----------------------------------------------------------
  # Internships was folded into Careers. The old URL has been live, is in the
  # sitemap Google already crawled, and may be in job posts and emails. A 301
  # keeps those links working instead of handing someone a 404 mid-application.
  # [NE] stops Apache escaping the # into %23.
  RewriteRule ^internships/?$      /careers#internships  [R=301,NE,L]
  RewriteRule ^internships\.html$  /careers#internships  [R=301,NE,L]

  # --- Keep the repo's plumbing off the web ----------------------------------
  # Done with rewrite rather than <FilesMatch> + Require, because Require needs
  # a broader AllowOverride than many shared hosts grant, and getting that
  # wrong 500s the whole site.
  RewriteRule ^(\.git|\.github|scripts|worker)(/|$)  - [R=404,L]
  RewriteRule ^(_redirects|README\.md|\.gitignore)$  - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  # --- Security headers ------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"

  # The legacy XSS auditor is itself a vulnerability class. 0 disables it,
  # which is the current recommendation. Not 1.
  Header always set X-XSS-Protection "0"

  # HSTS. Deliberately WITHOUT preload and WITHOUT includeSubDomains for now.
  # Turn those on only once every subdomain is confirmed HTTPS-only — preload
  # is close to irreversible and can take a subdomain offline for a year.
  # Only meaningful once the certificate is live and HTTPS is forced.
  Header always set Strict-Transport-Security "max-age=31536000"

  Header always unset X-Powered-By
  Header always unset Server

  # --- Content Security Policy ----------------------------------------------
  # REPORT-ONLY. This blocks nothing; it reports what it WOULD block to the
  # browser console. Click through every page, confirm the console is clean,
  # then change the header name to Content-Security-Policy to enforce.
  # Shipping a CSP straight to enforce on a site nobody has clicked through is
  # how you take the fonts, the map and the job feed down simultaneously.
  #
  # The two sha256 values are the two inline <script> blocks on the site
  # (index.html and openings.html). THEY BREAK IF EITHER BLOCK IS EDITED, even
  # by one space. Regenerate with: python3 scripts/csp-hashes.py
  Header always set Content-Security-Policy-Report-Only "default-src 'none'; script-src 'self' https://unpkg.com 'sha256-ZN5Pt+7f2CoA7lYAKlVFFIMynFz72L2ZI0YRIHO4cKQ=' 'sha256-Bz4/PwA3MNu5MhBW0IotM5+wsVuXUJ5RdDaezEf5LXU='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.basemaps.cartocdn.com; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"

  # style-src keeps 'unsafe-inline' because the markup uses style="" attributes
  # throughout. Attribute styles cannot be hashed without 'unsafe-hashes', and
  # inline STYLE is a far smaller risk than inline SCRIPT. Removing it means
  # refactoring several hundred attributes — real work, not launch-night work.
</IfModule>

# NOTE ON FORCING HTTPS. There is deliberately no http->https rewrite here.
# Use Hostinger's own "Force HTTPS" toggle in hPanel instead. Doing it in
# .htaccess behind a host that terminates TLS at a proxy is the classic cause
# of an infinite redirect loop, and the host's own toggle knows its topology.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType text/html               "access plus 0 seconds"

  # jobs.json is rewritten hourly by the JazzHR sync. Caching it means the
  # openings page shows roles that are already filled. The page requests it
  # with cache:'no-store', but an intermediate proxy does not have to honour
  # that and this does.
  ExpiresByType application/json        "access plus 0 seconds"
</IfModule>
